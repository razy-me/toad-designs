// 1. Tokens
>bg = #0f172a;
>cardBg = #1e293b;
>primary = #38bdf8;
>textMuted = #94a3b8;
>textLight = #ffffff;

// 2. Artboard
canvas "AnnouncementCard" {
    preset: og-image;
    background: >bg;
    export: image;
    
    // Unser zentraler Karten-Container
    stack #card {
        at: center of canvas;
        direction: vertical;
        size: 900px;
        padding: 48px;
        gap: 24px;
        radius: 20px;
        fill: >cardBg;
        stroke: #334155 1px;
    }
}