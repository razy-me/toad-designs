// ============================================================================
// 🧬 TOAD MULTI-DNA INSPIRATION MATRIX (Min 3 Personas + Min 3 Corporate Systems)
// ----------------------------------------------------------------------------
// 🎭 CREATIVE PERSONAS (the_seed/09_CREATIVE_PERSONAS_AND_STYLES/):
//   1. [felix_aero_lindner]       -> Geometric vector signet purism, golden-ratio circular construction, surgical balance
//   2. [devon_bitshift_miller]    -> Developer-dark theme, high-contrast matrix emerald/cyan tokens, compiler syntax styling
//   3. [dr_volker_blueprint_rabe]  -> Technical CAD micro-grid, precision corner registration crosshairs, dimension ticks
//   4. [zephyr_kallisto]          -> Algorithmic vector geometric rhythm, structured linear accents, mathematical alignment
// 🏢 CORPORATE DESIGN SYSTEMS (the_seed/10_CORPORATE_DESIGN_SYSTEMS/):
//   1. [cybervault_security]      -> Deep aerospace dark palette (#030712, #080f24), laser cyan telemetry, tactical borders
//   2. [streamflow_devops]        -> Developer-tooling hierarchy, compiler status telemetry badges, monospace code styling
//   3. [kruppstahl_maschinenbau]  -> Precision engineering discipline, disciplined 6-8px radii, 8pt spatial grid alignment
// ============================================================================

// --- Explicit Typography Declarations (Synchronized with ./fonts/) ---
@font "./fonts/segoeui.ttf" as "Segoe UI" weight: 400 style: normal;
@font "./fonts/segoeuib.ttf" as "Segoe UI" weight: 700 style: normal;
@font "./fonts/consola.ttf" as "Consolas" weight: 400 style: normal;
@font "./fonts/consolab.ttf" as "Consolas" weight: 700 style: normal;

// --- Design Tokens & Palette ---
>fontDisplay    = "Segoe UI, -apple-system, sans-serif";
>fontMono       = "Consolas, monospace";

>bgCanvas       = #030712;
>bgMid          = #070e22;
>bgDeep         = #02050e;
>bgConsole      = alpha(#050c1e, 0.94);

>borderTactical = alpha(#00f0ff, 0.28);
>borderMuted    = alpha(#ffffff, 0.09);
>gridHairline   = alpha(#00f0ff, 0.04);
>crosshairColor = alpha(#00f0ff, 0.35);

>accentEmerald  = #10b981;
>toxicLime      = #ccff00;
>cyanLaser      = #00f0ff;
>accentBlue     = #38bdf8;
>accentPurple   = #a855f7;
>accentAmber    = #f59e0b;

>textWhite      = #ffffff;
>textLight      = #f1f5f9;
>textMuted      = #94a3b8;
>textDim        = #64748b;

// --- Canvas Definition: Official 1500 x 500 px (3:1 Widescreen) ---
canvas "ToadSocialBanner" {
    preset: twitter-header;
    font-family: >fontDisplay;
    background: linear-gradient(135deg, >bgCanvas 0%, >bgMid 55%, >bgDeep 100%);
    export: all;
    scales: [1, 2];
    quality: 100;
}

// ============================================================================
// 1. ARCHITECTURAL CAD BLUEPRINT GRID & CALIBRATION (Dr. Volker Rabe & Felix Lindner)
// ============================================================================

// Precision Horizontal CAD Gridlines
rect #cadH1 { size: 1500px 1px; fill: >gridHairline; at: (0px, 75px); }
rect #cadH2 { size: 1500px 1px; fill: >gridHairline; at: (0px, 250px); }
rect #cadH3 { size: 1500px 1px; fill: >gridHairline; at: (0px, 425px); }

// Precision Vertical CAD Gridlines
rect #cadV1 { size: 1px 500px; fill: >gridHairline; at: (150px, 0px); }
rect #cadV2 { size: 1px 500px; fill: >gridHairline; at: (750px, 0px); }
rect #cadV3 { size: 1px 500px; fill: >gridHairline; at: (1350px, 0px); }

// Corner Registration Crosshairs (Zero Purple Haze, Pure Precision Engineering)
text #regTopLeft {
    content: "[+] SYS_ORIGIN // X:0000 Y:0000";
    font-family: >fontMono;
    font-size: 10px;
    font-weight: 700;
    color: >crosshairColor;
    letter-spacing: 1.5px;
    at: (48px, 32px);
}

text #regTopRight {
    content: "CANVAS: 1500x500 [3:1] • SCALE: 1x/2x [+]";
    font-family: >fontMono;
    font-size: 10px;
    font-weight: 700;
    color: >crosshairColor;
    letter-spacing: 1.5px;
    at: (1160px, 32px);
}

text #regBottomLeft {
    content: "[+] LATENCY: 3.8ms • ENGINE: SKIA-2D • SOLVER: 4-PASS";
    font-family: >fontMono;
    font-size: 10px;
    font-weight: 700;
    color: >crosshairColor;
    letter-spacing: 1.2px;
    at: (48px, 462px);
}

text #regBottomRight {
    content: "TOAD-DSL // STABLE COMPILER RELEASE [+]";
    font-family: >fontMono;
    font-size: 10px;
    font-weight: 700;
    color: >crosshairColor;
    letter-spacing: 1.2px;
    at: (1180px, 462px);
}

// ============================================================================
// 2. MAIN HERO COMPOSITION (Balanced 2-Column Industrial Architecture)
// ============================================================================
stack #bannerRoot {
    direction: horizontal;
    gap: 48px;
    align: center;
    size: 1390px hug;
    at: center of canvas;

    // ========================================================================
    // LEFT COLUMN: Brand Identity, Engineering Narrative & Spec Chips (730px)
    // ========================================================================
    stack #leftColumn {
        direction: vertical;
        gap: 16px;
        size: 730px hug;

        // Telemetry Status Badge (Precision-anchored: dot center = 13px, text center = 13px, badge = 26px)
        group #engineStatusBadge {
            size: 382px 26px;
            radius: 4px;
            fill: alpha(>accentEmerald, 0.12);
            stroke: alpha(>accentEmerald, 0.45) 1px;

            circle #pulseDot {
                size: 6px;
                fill: >accentEmerald;
                shadow: 0px 0px 8px >accentEmerald;
                at: (12px, 10px);
            }

            text #engineStatusText {
                content: "TOAD COMPILER ENGINE • v1.0.0 • NATIVE PSD & SVG";
                font-family: >fontMono;
                font-size: 11px;
                font-weight: 700;
                color: >accentEmerald;
                letter-spacing: 1.2px;
                at: (26px, 11px);
            }
        }

        // Master Brand Lockup (Cyber-Toad Emblem + Wordmark)
        stack #brandRow {
            direction: horizontal;
            gap: 20px;
            align: center;
            size: 730px hug;

            // --- Official 2D Fusion Tile Toad Logo Signet (86x86) ---
            group #emblemFrame {
                size: 86px 86px;

                // Base Emerald Squircle Chassis
                rect #tileChassis {
                    size: 86px 86px;
                    radius: 25px;
                    fill: >accentEmerald;
                    shadow: 0px 8px 24px alpha(>accentEmerald, 0.25);
                    at: (0px, 0px);
                }

                // White Toad Silhouette & Syntax Chevron
                group #silhBrand {
                    size: 60px 42px;
                    at: (13px, 22px);

                    // Left & Right Eye Domes
                    circle { size: 21px; fill: >textWhite; at: (5px, 0px); }
                    circle { size: 21px; fill: >textWhite; at: (34px, 0px); }

                    // Body Capsule
                    rect { size: 60px 30px; radius: 15px; fill: >textWhite; at: (0px, 12px); }

                    // Negative Space Syntax Chevron (">")
                    path {
                        d: "M 26 21 L 34 27 L 26 33";
                        size: 60px 42px;
                        stroke: >accentEmerald 5.5px;
                        stroke-cap: round;
                        stroke-join: round;
                        fill: transparent;
                        at: (0px, 0px);
                    }
                }
            }

            // Wordmark & Subtitle Block
            stack #wordmarkBlock {
                direction: vertical;
                gap: 2px;

                // Typographically anchored title row with exact baseline match
                group #titleRow {
                    size: 195px 56px;

                    text #logoToad {
                        content: "toad";
                        font-size: 52px;
                        font-weight: 700;
                        color: >textWhite;
                        letter-spacing: -1.5px;
                        at: (0px, 0px);
                    }

                    text #logoDsl {
                        content: ".dsl";
                        font-size: 28px;
                        font-weight: 700;
                        color: >cyanLaser;
                        at: right of #logoToad offset (3px, 22px);
                    }
                }

                text #taglineText {
                    content: "SPATIAL DESIGN LANGUAGE & GRAPHICS COMPILER";
                    font-family: >fontMono;
                    font-size: 10.5px;
                    font-weight: 700;
                    color: >accentEmerald;
                    letter-spacing: 2.2px;
                }
            }
        }

        // High-Contrast Punchy Headline
        text #heroHeadline {
            content: "Declarative layout. Native Photoshop PSD compilation.";
            font-size: 23.5px;
            font-weight: 700;
            color: >textLight;
            letter-spacing: -0.5px;
            size: 730px auto;
        }

        // Domain-Specific Engineering Copy
        text #heroCopy {
            content: "Compile declarative AST directly into pixel-perfect SVGs, Skia-rendered 2D raster buffers, and layered Photoshop PSDs with native text layers (TySh), 4-pass constraint math, and multi-scale Retina support.";
            font-size: 13.5px;
            font-weight: 400;
            color: >textMuted;
            line-height: 20px;
            size: 710px auto;
        }

        // Kruppstahl-Style Structured Spec Chips (Precision-aligned: icon center = 15px, text center = 15px)
        stack #specChipsRow {
            direction: horizontal;
            gap: 10px;
            size: 730px hug;

            group #chip1 {
                size: 136px 30px;
                radius: 4px;
                fill: alpha(#ffffff, 0.04);
                stroke: >borderMuted 1px;

                icon {
                    iconName: "settings";
                    size: 13px;
                    stroke: >accentBlue 1.8px;
                    at: (12px, 8.5px);
                }

                text {
                    content: "4-Pass Math";
                    font-family: >fontMono;
                    font-size: 12px;
                    font-weight: 700;
                    color: >accentBlue;
                    at: (33px, 12px);
                }
            }

            group #chip2 {
                size: 154px 30px;
                radius: 4px;
                fill: alpha(#ffffff, 0.04);
                stroke: >borderMuted 1px;

                icon {
                    iconName: "check";
                    size: 13px;
                    stroke: >accentEmerald 2px;
                    at: (12px, 8.5px);
                }

                text {
                    content: "Skia 2D Native";
                    font-family: >fontMono;
                    font-size: 12px;
                    font-weight: 700;
                    color: >accentEmerald;
                    at: (33px, 12px);
                }
            }

            group #chip3 {
                size: 188px 30px;
                radius: 4px;
                fill: alpha(#ffffff, 0.04);
                stroke: >borderMuted 1px;

                icon {
                    iconName: "arrow-right";
                    size: 13px;
                    stroke: >cyanLaser 1.8px;
                    at: (12px, 8.5px);
                }

                text {
                    content: "Layered PSDs (TySh)";
                    font-family: >fontMono;
                    font-size: 12px;
                    font-weight: 700;
                    color: >cyanLaser;
                    at: (33px, 12px);
                }
            }

            group #chip4 {
                size: 172px 30px;
                radius: 4px;
                fill: alpha(#ffffff, 0.04);
                stroke: >borderMuted 1px;

                icon {
                    iconName: "settings";
                    size: 13px;
                    stroke: >accentPurple 1.8px;
                    at: (12px, 8.5px);
                }

                text {
                    content: "Retina @1x / @2x";
                    font-family: >fontMono;
                    font-size: 12px;
                    font-weight: 700;
                    color: >accentPurple;
                    at: (33px, 12px);
                }
            }
        }
    }

    // ========================================================================
    // RIGHT COLUMN: High-Tech Compiler Terminal & Live Telemetry Bar (612px)
    // ========================================================================
    stack #compilerConsole {
        direction: vertical;
        size: 612px hug;
        radius: 6px;
        fill: >bgConsole;
        stroke: >borderTactical 1px;
        shadow: 0px 20px 48px alpha(#000000, 0.7);

        // Window Chrome & Telemetry Strip (Pixel-perfect group alignment)
        group #consoleHeader {
            size: 612px 38px;
            fill: alpha(#ffffff, 0.03);
            stroke: alpha(#ffffff, 0.07) 1px;

            // Active Tab Pill (24px height, centered in 38px header at y=7)
            rect #tabActiveBg {
                size: 96px 24px;
                radius: 3px;
                fill: alpha(>cyanLaser, 0.12);
                stroke: alpha(>cyanLaser, 0.35) 1px;
                at: (16px, 7px);
            }

            text #tabActiveText {
                content: "banner.toad";
                font-family: >fontMono;
                font-size: 11px;
                font-weight: 700;
                color: >cyanLaser;
                at: (25px, 17px);
            }

            // Inactive Tab Text (Identical vertical coordinate)
            text #tabSecondaryText {
                content: "tokens.toad";
                font-family: >fontMono;
                font-size: 11px;
                font-weight: 400;
                color: >textDim;
                at: (124px, 17px);
            }

            // Build Pill (Right-aligned inside header)
            group #buildPill {
                size: 160px 24px;
                radius: 3px;
                fill: alpha(>accentEmerald, 0.12);
                stroke: alpha(>accentEmerald, 0.4) 1px;
                at: (436px, 7px);

                circle #buildDot {
                    size: 6px;
                    fill: >accentEmerald;
                    shadow: 0px 0px 6px >accentEmerald;
                    at: (12px, 9px);
                }

                text #buildPillText {
                    content: "COMPILED • 0 ERRORS";
                    font-family: >fontMono;
                    font-size: 10px;
                    font-weight: 700;
                    color: >accentEmerald;
                    letter-spacing: 0.8px;
                    at: (26px, 10.5px);
                }
            }
        }

        // Live TOAD DSL Code Body (Monospaced & Pure Syntax Highlighting)
        stack #consoleBody {
            direction: vertical;
            padding: [16px, 20px, 16px, 20px];
            gap: 7px;
            size: 100% hug;

            // Line 1: @font directive
            stack #codeL1 {
                direction: horizontal;
                gap: 14px;
                text { content: "01"; font-family: >fontMono; font-size: 12px; font-weight: 400; color: alpha(>textMuted, 0.35); }
                text { content: "@font \"./fonts/segoeui.ttf\" as \"Segoe UI\";"; font-family: >fontMono; font-size: 12px; font-weight: 400; color: >cyanLaser; }
            }

            // Line 2: Variable declaration
            stack #codeL2 {
                direction: horizontal;
                gap: 14px;
                text { content: "02"; font-family: >fontMono; font-size: 12px; font-weight: 400; color: alpha(>textMuted, 0.35); }
                text { content: ">brand = #10b981;  >cyan = #00f0ff;"; font-family: >fontMono; font-size: 12px; font-weight: 400; color: >toxicLime; }
            }

            // Line 3: Canvas block header
            stack #codeL3 {
                direction: horizontal;
                gap: 14px;
                text { content: "03"; font-family: >fontMono; font-size: 12px; font-weight: 400; color: alpha(>textMuted, 0.35); }
                text { content: "canvas \"SocialBanner\" {"; font-family: >fontMono; font-size: 12px; font-weight: 700; color: >accentPurple; }
            }

            // Line 4: Preset
            stack #codeL4 {
                direction: horizontal;
                gap: 14px;
                text { content: "04"; font-family: >fontMono; font-size: 12px; font-weight: 400; color: alpha(>textMuted, 0.35); }
                text { content: "    preset: twitter-header;  // 1500x500 3:1"; font-family: >fontMono; font-size: 12px; font-weight: 400; color: >textLight; }
            }

            // Line 5: Multi-format export
            stack #codeL5 {
                direction: horizontal;
                gap: 14px;
                text { content: "05"; font-family: >fontMono; font-size: 12px; font-weight: 400; color: alpha(>textMuted, 0.35); }
                text { content: "    export: [png, psd, svg]; scales: [1, 2];"; font-family: >fontMono; font-size: 12px; font-weight: 400; color: >accentBlue; }
            }

            // Line 6: Canvas closing
            stack #codeL6 {
                direction: horizontal;
                gap: 14px;
                text { content: "06"; font-family: >fontMono; font-size: 12px; font-weight: 400; color: alpha(>textMuted, 0.35); }
                text { content: "}"; font-family: >fontMono; font-size: 12px; font-weight: 700; color: >accentPurple; }
            }

            // Line 7: Stack component definition
            stack #codeL7 {
                direction: horizontal;
                gap: 14px;
                text { content: "07"; font-family: >fontMono; font-size: 12px; font-weight: 400; color: alpha(>textMuted, 0.35); }
                text { content: "stack #root { direction: horizontal; gap: 48px; }"; font-family: >fontMono; font-size: 12px; font-weight: 400; color: >textMuted; }
            }
        }

        // Terminal Telemetry Footer Bar (Pixel-perfect group alignment)
        group #consoleFooter {
            size: 612px 36px;
            fill: alpha(#ffffff, 0.02);
            stroke: alpha(#ffffff, 0.06) 1px;

            icon #footerCheck {
                iconName: "check";
                size: 13px;
                stroke: >accentEmerald 2.2px;
                at: (18px, 11px);
            }

            text #footerBuildText {
                content: "BUILD: 3.8ms";
                font-family: >fontMono;
                font-size: 11px;
                font-weight: 700;
                color: >accentEmerald;
                letter-spacing: 0.5px;
                at: (38px, 15px);
            }

            text #footerStatsRight {
                content: "18 PSD Layers (TySh) • Skia 2D • Retina 2x";
                font-family: >fontMono;
                font-size: 11px;
                font-weight: 400;
                color: >textMuted;
                at: (330px, 15px);
            }
        }
    }
}
