>bgPaper = #eff2f5;
>inkBlue = #1a3258;

canvas "Test-Texture" {
  size: 1000px 1400px;
  background: >bgPaper;
  export: png;
}

rect #frameBorder {
  size: 920px 1156px;
  fill: transparent;
  stroke: >inkBlue 1.5px;
  at: (40px, 40px);
}

circle #testShape {
  size: 400px;
  fill: >inkBlue;
  at: (300px, 300px);
}

image #textureMasked {
  src: "./paper_texture.png";
  size: 1000px 1400px;
  at: (0px, 0px);
  opacity: 0.45;
  blend-mode: overlay;
  mask: #testShape;
}
