// ============================================================================
// 🧬 TOAD MULTI-DNA INSPIRATION MATRIX (Min 3 Personas + Min 3 Corporate Systems)
// ----------------------------------------------------------------------------
// 🎭 CREATIVE PERSONAS (the_seed/09_CREATIVE_PERSONAS_AND_STYLES/):
//   1. jessica_sterling -> Precise Swiss spatial proportions, disciplined margins, hairline rules
//   2. felix_aero_lindner -> Constructivist geometry, technical line art, pure 1-color screenprint
//   3. darius_cole -> Brutalist industrial streetwear aesthetics, stark high-contrast graphics
// 🏢 CORPORATE DESIGN SYSTEMS (the_seed/10_CORPORATE_DESIGN_SYSTEMS/):
//   1. metro_transvia -> Modernist technical typography discipline, clean weights
//   2. rostwerk_kaffee -> Pure monochrome screenprint tokens
//   3. schoko_kuvertuere -> Precision layout margins, clean print-ready silhouettes
// ============================================================================

// --- 1-Color Screenprint Tokens (Pure Black on Transparent Canvas for White/Light Shirts) ---
>inkBlack      = #000000;
>fontSans      = "Arial, Helvetica, sans-serif";
>fontMono      = "Consolas, Courier New, monospace";

// ============================================================================
// CANVAS CONFIGURATION (Apparel Print Graphic: 1600x2400 @ 300DPI)
// ============================================================================

canvas "Deftones-Warehouse-Label-Black" {
  size: 1600px 2400px;
  background: transparent;
  font-family: >fontSans;
  export: all;
  quality: 100;
}

// ============================================================================
// OUTER INDUSTRIAL SPECIFICATION FRAME
// ============================================================================

// Outer bounding border
rect #outerBorder {
  size: 1440px 2240px;
  at: (80px, 80px);
  fill: transparent;
  stroke: >inkBlack 4px;
}

// Inner technical border
rect #innerBorder {
  size: 1408px 2208px;
  at: (96px, 96px);
  fill: transparent;
  stroke: >inkBlack 1px;
}

// Technical Corner Brackets / Registration Markers
rect #bracketTLH { size: 40px 6px; fill: >inkBlack; at: (80px, 80px); }
rect #bracketTLV { size: 6px 40px; fill: >inkBlack; at: (80px, 80px); }

rect #bracketTRH { size: 40px 6px; fill: >inkBlack; at: (1480px, 80px); }
rect #bracketTRV { size: 6px 40px; fill: >inkBlack; at: (1514px, 80px); }

rect #bracketBLH { size: 40px 6px; fill: >inkBlack; at: (80px, 2314px); }
rect #bracketBLV { size: 6px 40px; fill: >inkBlack; at: (80px, 2280px); }

rect #bracketBRH { size: 40px 6px; fill: >inkBlack; at: (1480px, 2314px); }
rect #bracketBRV { size: 6px 40px; fill: >inkBlack; at: (1514px, 2280px); }

