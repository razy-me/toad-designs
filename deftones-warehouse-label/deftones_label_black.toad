// Track 1
rect #trkBox1 { size: 330px 140px; at: (120px, 1445px); fill: transparent; stroke: >inkBlack 1px; }
text #trkCode1 { content: "TRK-01 // FEITICEIRA"; font-family: >fontMono; font-size: 15px; font-weight: 800; color: >inkBlack; at: (138px, 1465px); }
text #trkParam1 { content: "TEMPO: 140 BPM\nTIME: 03:09\nKEY: D# MINOR\nGAIN: +4.2 dB"; font-family: >fontMono; font-size: 12px; font-weight: 600; color: >inkBlack; line-height: 1.5; at: (138px, 1495px); }

// Track 2
