text #trkParam3 { content: "GRAMMY AWARD WIN\nTIME: 04:01\nVOCAL: VOCODER DIST\nFREQ: 2.4 kHz PEAK"; font-family: >fontMono; font-size: 12px; font-weight: 600; color: >inkBlack; line-height: 1.5; at: (838px, 1495px); }

// Track 4
