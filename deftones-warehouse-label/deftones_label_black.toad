text #trkParam2 { content: "TEMPO: 128 BPM\nTIME: 04:15\nDELAY: REVERB MATRIX\nDRUM: REVERSE COMP"; font-family: >fontMono; font-size: 12px; font-weight: 600; color: >inkBlack; line-height: 1.5; at: (488px, 1495px); }

// Track 3
